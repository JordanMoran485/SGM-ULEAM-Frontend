# URL base del backend Laravel (SIN slash final).
# Copia este archivo a .env y ajusta el valor según tu entorno.
#
# Producción:
EXPO_PUBLIC_API_BASE_URL=https://jordan.spondycraft.net
#
# Desarrollo local (elige según cómo levantes Laravel):
#   Emulador/web en la misma máquina:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#   Dispositivo físico en tu red (usa la IP LAN de tu PC):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.100.9:8000
